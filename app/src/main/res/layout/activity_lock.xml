<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@color/background" android:padding="24dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Expense Tracker" android:textSize="22sp" android:textStyle="bold"
        android:textColor="@color/primary" android:layout_marginBottom="8dp"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Enter your PIN" android:textColor="@color/text_secondary"
        android:layout_marginBottom="24dp"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="32dp">
        <View android:id="@+id/dot1" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_margin="8dp" android:background="@drawable/bg_dot" android:alpha="0.3"/>
        <View android:id="@+id/dot2" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_margin="8dp" android:background="@drawable/bg_dot" android:alpha="0.3"/>
        <View android:id="@+id/dot3" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_margin="8dp" android:background="@drawable/bg_dot" android:alpha="0.3"/>
        <View android:id="@+id/dot4" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_margin="8dp" android:background="@drawable/bg_dot" android:alpha="0.3"/>
    </LinearLayout>

    <GridLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:columnCount="3" android:alignmentMode="alignMargins">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn1" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="1" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn2" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="2" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn3" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="3" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn4" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="4" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn5" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="5" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn6" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="6" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn7" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="7" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn8" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="8" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn9" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="9" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnClear" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="C" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn0" style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="0" android:layout_margin="6dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnBio" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="72dp" android:layout_height="72dp" android:text="👆" android:layout_margin="6dp"/>
    </GridLayout>
</LinearLayout>
