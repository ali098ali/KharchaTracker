<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" app:cardCornerRadius="12dp" app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp">
        <View android:id="@+id/view_dot" android:layout_width="10dp" android:layout_height="10dp"
            android:background="@drawable/bg_dot"
            app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="@id/tv_category"
            app:layout_constraintBottom_toBottomOf="@id/tv_category"/>
        <TextView android:id="@+id/tv_category" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textStyle="bold" android:textSize="14sp"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toEndOf="@id/view_dot" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tv_amount"/>
        <TextView android:id="@+id/tv_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textStyle="bold" android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent"/>
        <TextView android:id="@+id/tv_note" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="@color/text_secondary"
            app:layout_constraintStart_toStartOf="@id/tv_category" app:layout_constraintTop_toBottomOf="@id/tv_category"
            app:layout_constraintEnd_toStartOf="@id/btn_delete"/>
        <TextView android:id="@+id/tv_date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/text_hint"
            app:layout_constraintStart_toStartOf="@id/tv_category" app:layout_constraintTop_toBottomOf="@id/tv_note"/>
        <TextView android:id="@+id/tv_method" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="@color/text_hint"
            app:layout_constraintStart_toEndOf="@id/tv_date" app:layout_constraintTop_toTopOf="@id/tv_date"/>
        <ImageButton android:id="@+id/btn_delete" android:layout_width="32dp" android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_delete" android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_hint"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
